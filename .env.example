# ========================================================
# OPTION 1: EmailJS (Recommended for Vite + React Frontends)
# 1. Sign up free at https://www.emailjs.com
# 2. Add 'Gmail' as your Email Service (connect kalpanabhandari383@gmail.com)
# 3. Create an Email Template with fields: {{from_name}}, {{from_email}}, {{subject}}, {{message}}
# 4. Copy your Service ID, Template ID, and Public Key below:
# ========================================================
VITE_EMAILJS_SERVICE_ID="service_xxxxxxx"
VITE_EMAILJS_TEMPLATE_ID="template_xxxxxxx"
VITE_EMAILJS_PUBLIC_KEY="public_key_xxxxxxx"

# ========================================================
# OPTION 2: Web3Forms Access Key (Instant Setup to your Gmail)
# 1. Enter your Gmail on https://web3forms.com
# 2. An access key is instantly emailed to your Gmail
# 3. Paste the access key below:
# ========================================================
VITE_WEB3FORMS_ACCESS_KEY="your-access-key-here"

# ========================================================
# OPTION 3: Google App Password (for Vercel Serverless Function: /api/contact)
# 1. In your Google Account: Security -> 2-Step Verification -> App Passwords
# 2. Generate an App Password for 'Mail'
# 3. Add to Vercel Project Settings -> Environment Variables:
# ========================================================
GMAIL_USER="kalpanabhandari383@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-google-app-password"
